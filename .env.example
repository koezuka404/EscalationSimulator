APP_ENV=development
HTTP_PORT=8083

JWT_SECRET=change-me-use-at-least-32-bytes!!
JWT_ISSUER=escalator-api
JWT_AUDIENCE=escalator-client
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=30

BCRYPT_COST=12
COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_NAME=escalator_refresh_token
CSRF_TOKEN_COOKIE_NAME=escalator_csrf_token

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
PRIORITY_RECALC_SECONDS=30
AGENT_DISCONNECT_GRACE_SECONDS=300

CORS_ALLOWED_ORIGIN=http://localhost:5175
REDIS_PUBSUB_CHANNEL_PREFIX=escalator:notify:

DATABASE_URL=postgres://escalator:escalator@localhost:5438/escalator?sslmode=disable
REDIS_URL=redis://localhost:6384/0
